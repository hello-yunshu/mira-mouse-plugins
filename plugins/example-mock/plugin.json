    { "id": "dpi", "control": "DpiStages", "labelKey": "dpi", "readOnly": true, "placements": [{ "region": "control", "group": "performance", "order": 10, "span": 1, "icon": "gauge", "priority": 100, "dashboardRole": "fixed-core", "fixedSlot": 1, "fourthSlotEligible": false, "dedupeKey": "dashboard.dpi", "fallbackRegion": "advanced" }] },
    { "id": "polling-rate", "control": "Segmented", "labelKey": "pollingRate", "readOnly": true, "placements": [{ "region": "control", "group": "polling", "order": 20, "span": 1, "icon": "wave", "priority": 100, "dashboardRole": "fixed-core", "fixedSlot": 2, "fourthSlotEligible": false, "dedupeKey": "dashboard.polling-rate", "fallbackRegion": "advanced" }] },
    { "id": "mouse-light", "control": "LightingZone", "labelKey": "mouseLight", "readOnly": true, "placements": [{ "region": "control", "group": "lighting", "order": 30, "span": 1, "icon": "lightbulb", "priority": 100, "dashboardRole": "fixed-core", "fixedSlot": 3, "fourthSlotEligible": false, "dedupeKey": "dashboard.lighting", "fallbackRegion": "advanced" }] },
